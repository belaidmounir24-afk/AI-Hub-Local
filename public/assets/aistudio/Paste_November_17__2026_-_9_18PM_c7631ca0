package com.example.aios;

import android.os.Bundle;
import android.webkit.WebSettings;
import android.webkit.WebView;
import android.webkit.WebViewClient;
import androidx.appcompat.app.AppCompatActivity;

public class MainActivity extends AppCompatActivity {

    private WebView webView;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        
        // Crée la WebView dynamiquement ou utilise le layout XML
        webView = new WebView(this);
        setContentView(webView);

        // Configuration essentielle pour ton application IA
        WebSettings webSettings = webView.getSettings();
        webSettings.setJavaScriptEnabled(true); // Indispensable pour tes scripts JS et l'IA
        webSettings.setDomStorageEnabled(true); // Pour sauvegarder des données si besoin
        webSettings.setAllowFileAccess(true);

        // Force l'ouverture des liens dans la WebView et non dans le navigateur externe
        webView.setWebViewClient(new WebViewClient());

        // Charge ton fichier index.html situé dans le dossier assets
        webView.loadUrl("file:///android_asset/index.html");
    }

    // Gère le bouton "Retour" du téléphone pour naviguer dans l'historique de l'app
    @Override
    public void onBackPressed() {
        if (webView.canGoBack()) {
